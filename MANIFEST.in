include README.md
include LICENSE
include pyproject.toml
include mkdocs.yml
include requirements-docs.txt
include pytest.ini
recursive-include tests *.py
recursive-include torchbvh/csrc *.cpp *.cu *.cuh
recursive-include docs *.md
recursive-include docs/assets *.svg *.png
recursive-include examples *.ipynb
recursive-include examples *.png
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.pyd
global-exclude *.so
global-exclude *.dll
global-exclude *.obj
global-exclude *.exp
global-exclude *.lib
